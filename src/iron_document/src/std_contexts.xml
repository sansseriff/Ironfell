<!-- Iron's built-in contexts (plans/specs/contexts.md §2.2): the user-agent
     stylesheet. Read-only, never saved; a document overrides them sparsely.
     A node's values come from its notation's context (by type), its own
     context (`self` rules), and its direct container's context (`children`
     rules), nearer winning; a `through` container is passed over, as CSS's
     `display: contents` is. `all` is self and children. -->

<context name="std:free-2d">
  <!-- What a press selects: content, not its parts (points, contours,
       constraints, ports, anchors). -->
  <rule match="type:rect|ellipse|path|slider|text|table|group|use|empty" affords.select="target" affords.drag="point" affords.grips="box" snap.target="yes"/>
  <!-- An embed at the top of a view is a window: its content selects directly. -->
  <rule match="type:embed" affords.select="window" affords.drag="point" affords.grips="box" snap.target="yes"/>
  <rule match="type:empty" snap.target="no"/>
  <!-- A rect's corners round, an ellipse's arc opens, by their own handles. -->
  <rule match="type:rect|ellipse" affords.grips="box shape"/>
  <!-- A slider is a control: a press on it drives its value. -->
  <rule match="type:slider" affords.drag="track"/>
  <!-- Containers light as frames; shapes as their outlines. -->
  <rule match="type:group|use|empty|embed" chrome.lit="frame"/>
  <rule match="type:text" affords.edit="text"/>
  <rule match="type:rect|ellipse|path" affords.edit="points"/>
  <!-- What a view of a free 2D world offers (contexts.md §2.7): Figma's tools
       and keys. The shapes share a slot. -->
  <rule match="view" palette.tools="select rect|ellipse|table|empty pen text" keys.tools="v:select p:pen r:rect o:ellipse t:text" inspector.sections="main port component table position text layout appearance fill stroke effects other add"/>
  <!-- Where a component's main is, a port can be placed on it. -->
  <rule match="view state:main" palette.tools="select rect|ellipse|table|port|empty pen text"/>
</context>

<context name="std:3d">
  <!-- A 3D world has no tools yet: no palette, no keys. -->
  <rule match="type:mesh|group|use|empty|embed" affords.select="target"/>
</context>

<context name="std:table" for="type:table">
  <!-- Rows are structure, not targets: a double-click on a table reaches a
       cell, as in Slides and PowerPoint. -->
  <rule match="type:row" affords.select="through"/>
  <!-- ARIA's grid: arrows move cell to cell, Tab to the next (a new row past
       the last), Enter edits, Esc goes back to the table. -->
  <rule match="self" keys.nav="grid"/>
</context>

<!-- A group laid out in a line (layout-and-tables.md §2): ARIA's listbox
     along its axis; Alt with an arrow moves the item. -->
<context name="std:row" for="type:group layout.mode=stack_x">
  <rule match="self" keys.nav="list-x"/>
  <!-- Figma's auto layout: a drag reorders, the others opening a gap, and
       they glide when layout moves them. -->
  <rule match="children" affords.drag="sequence" motion.placement="out 160 layout"/>
</context>

<context name="std:column" for="type:group layout.mode=stack_y">
  <rule match="self" keys.nav="list-y"/>
  <rule match="children" affords.drag="sequence" motion.placement="out 160 layout"/>
</context>

<!-- The timeline (timeline.md §7), a session composition generated from the
     clips (`timeline_view`). Its pieces are bound: a segment's x to its
     clip's start, its y to a literal, so a drag retimes the clip and moves
     only in time; the playhead to the clock; the ruler, ticks and headers to
     nothing free, so they stay put. No grips, no editing, no snapping yet
     (phase 3: `affords.grips="ends"`, `snap.targets`, `view.nav`). -->
<context name="std:timeline">
  <rule match="type:rect|text" affords.select="target" affords.drag="point"/>
  <rule match="view" palette.tools="select" keys.tools="v:select" chrome.component="off" inspector.sections="main position other"/>
</context>

<!-- An electrical schematic (schematic.md §3), in the spirit of a basic
     Altium: parts placed on a 10 px grid, wired pin to pin. Built-ins do
     not chain, so it states its own selection rules. -->
<context name="std:schematic">
  <rule match="type:use|text|path|group|empty|rect|ellipse|slider" affords.select="target" affords.drag="point" snap.target="yes"/>
  <rule match="type:slider" affords.drag="track"/>
  <!-- A symbol does not stretch; words and drawn shapes do. -->
  <rule match="type:text|rect|ellipse" affords.grips="box"/>
  <rule match="type:use|group|empty" chrome.lit="frame"/>
  <rule match="type:text" affords.edit="text"/>
  <!-- A wire's corners edit as a path's points. -->
  <rule match="type:path" affords.edit="points"/>
  <!-- Deleting a part's symbol deletes the part and its wires; deleting a
       wire deletes the connection it draws. -->
  <rule match="type:use|path" affords.delete="subject"/>
  <!-- A connection joins pins; it does not pull parts together. -->
  <rule match="all" plug.mate="no"/>
  <rule match="view" palette.tools="select wire place:resistor|place:capacitor|place:inductor place:vsource|place:isource place:ground place:probe text" keys.tools="v:select w:wire r:place:resistor c:place:capacitor l:place:inductor e:place:vsource i:place:isource g:place:ground p:place:probe t:text" snap.grid="10" chrome.component="off" inspector.sections="main component position text other"/>
</context>
