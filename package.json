{
  "name": "iron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "wasm": ".claude/skills/run-iron/build.sh",
    "wasm:fast": "PROFILE=wasm-bench .claude/skills/run-iron/build.sh",
    "wasm:smallfast": "./build-wasm.sh webgpu && ./build-wasm.sh webgl2",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "native:ui": "vite build --mode native",
    "native:build": "bun run native:ui && cd src-native && bunx --bun @tauri-apps/cli@2 build --debug --target aarch64-apple-darwin --bundles app --no-sign -- --profile dev-opt --bin iron-native",
    "native:run": "MACOSX_DEPLOYMENT_TARGET=14.0 cargo run -p iron-native --bin iron-native --profile dev-opt --target aarch64-apple-darwin"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.5",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-preload": "^0.4.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@lucide/svelte": "^1.57.0",
    "bits-ui": "^2.19.5",
    "dockview-core": "^8.5.1",
    "fast-xml-parser": "^5.11.1"
  }
}
