{
  "name": "iron",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:agent": "bun scripts/dev-agent.ts",
    "dev:agent:demo": "bun scripts/dev-agent.ts --demo",
    "native:run": "bun run native:ui && MACOSX_DEPLOYMENT_TARGET=14.0 cargo run -p iron-native --bin iron-native --profile dev-opt --target aarch64-apple-darwin",
    "native:agent": "bun scripts/native-agent.ts",
    "native:build": "bun run native:ui && cd src-native && bunx --bun @tauri-apps/cli@2 build --debug --target aarch64-apple-darwin --bundles app --no-sign -- --profile dev-opt --bin iron-native",
    "native:ui": "vite build --mode native",
    "wasm": ".claude/skills/run-iron/build.sh",
    "wasm:fast": "PROFILE=wasm-bench .claude/skills/run-iron/build.sh",
    "wasm:smallfast": "./build-wasm.sh webgpu && ./build-wasm.sh webgl2",
    "build": "vite build",
    "preview": "vite preview",
    "check": "python3 scripts/generate-ui-protocol.py --check && tsc -p tsconfig.protocol.json && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "protocol": "python3 scripts/generate-ui-protocol.py"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.6.5",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@lucide/svelte": "^1.57.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bits-ui": "^2.19.5",
    "dockview-core": "^8.5.1",
    "fast-xml-parser": "^5.11.1",
    "heic-to": "^1.6.7",
    "konva": "^10.9.1",
    "marked": "^18.1.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9"
  }
}
