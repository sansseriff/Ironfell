{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iron Native",
  "version": "0.0.1",
  "identifier": "org.ironfell.native-probe",
  "build": {
    "frontendDist": "probe-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Iron \u2014 native feasibility",
        "width": 1280,
        "height": 850,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "mainBinaryName": "iron-native-probe"
}
